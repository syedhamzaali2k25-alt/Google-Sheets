{
  "backendBaseUrl": "http://localhost:8000",
  "healthCheckPath": "/health",
  "authVerifyPath": "/auth/verify",
  "sheetsRawPathTemplate": "/sheets/{spreadsheetId}/raw",
  "sheetsStructurePathTemplate": "/sheets/{spreadsheetId}/structure",
  "sheetsHealthPathTemplate": "/sheets/{spreadsheetId}/health",
  "sheetsDocumentationPathTemplate": "/sheets/{spreadsheetId}/documentation",
  "sheetsChangesPathTemplate": "/sheets/{spreadsheetId}/changes",
  "sheetsExportPathTemplate": "/sheets/{spreadsheetId}/export",
  "sheetsHighlightDuplicatesPathTemplate": "/sheets/{spreadsheetId}/highlight-duplicates",
  "sheetsClearHighlightsPathTemplate": "/sheets/{spreadsheetId}/clear-highlights",
  "extensionOrigins": [
    "chrome-extension://__EXTENSION_ID__"
  ],
  "googleOAuthScopes": [
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/drive.metadata.readonly",
